 "structures": [
  {
   "id": "bukan-sekadar",
   "regex": "(?i)\\bbukan (?:sekadar|cuma|cuman|hanya) [^.!?\\n]{2,60}[,.]\\s*(?:tapi|tetapi|melainkan|namun)\\b",
   "name": "\"Bukan sekadar X, tapi Y\"",
   "fix": "Langsung katakan Y. Bagian 'bukan sekadar' itu cuma ancang-ancang.",
   "lang": "id"
  },
  {
   "id": "tidak-hanya",
   "regex": "(?i)\\b(?:tidak|nggak|gak|bukan) (?:hanya|cuma|sekadar)\\b[^.!?\\n]{2,80}\\b(?:tetapi|tapi|namun|melainkan) juga\\b",
   "name": "\"Tidak hanya X, tetapi juga Y\"",
   "fix": "Pecah jadi dua kalimat, atau buang bagian yang lebih lemah.",
   "lang": "id"
  },
  {
   "id": "bukan-tentang",
   "regex": "(?i)\\b(?:ini|itu) bukan (?:tentang|soal|masalah) [^.!?\\n]{2,60}[.!]\\s*(?:ini|itu) (?:tentang|soal)\\b",
   "name": "\"Ini bukan tentang X. Ini tentang Y.\"",
   "fix": "Mulai dari Y. Pembalikan itulah tandanya.",
   "lang": "id"
  },
  {
   "id": "hasilnya",
   "regex": "(?im)^\\s*(?:hasilnya|bagian terbaiknya|masalahnya|faktanya|rahasianya|intinya|jawabannya|kok bisa)\\?\\s*$",
   "name": "Baris tanya satu kata (\"Hasilnya?\")",
   "fix": "Gabungkan dengan kalimat jawabannya. Kejutan yang dipentaskan terbaca seperti template.",
   "lang": "id"
  },
  {
   "id": "berikut-titikdua",
   "regex": "(?i)\\b(?:berikut|ini dia|inilah) (?:adalah |ini )?(?:\\d+ )?(?:cara|tips|langkah|alasan|hal|rahasia)\\b[^.!?\\n]*:",
   "name": "\"Berikut adalah 5 cara...:\"",
   "fix": "Langsung masuk ke cara pertama. Pengantar daftar tidak perlu diumumkan.",
   "lang": "id"
  },
  {
   "id": "pernahkah",
   "regex": "(?i)\\bpernahkah (?:kamu|kalian|anda)\\b|\\bapakah (?:kamu|kalian|anda) (?:pernah|sering|merasa)\\b",
   "name": "\"Pernahkah kamu merasa...?\"",
   "fix": "Ganti pertanyaan retoris dengan kejadian nyata: siapa, kapan, berapa.",
   "lang": "id"
  },
  {
   "id": "bayangkan",
   "regex": "(?im)^\\s*(?:coba )?bayangkan\\b",
   "name": "Dibuka dengan \"Bayangkan...\"",
   "fix": "Jangan suruh orang membayangkan. Ceritakan yang benar-benar terjadi.",
   "lang": "id"
  },
  {
   "id": "triad-dan",
   "regex": "(?i)\\b\\w+, \\w+, dan \\w+\\.",
   "name": "Pola tiga (\"cepat, mudah, dan murah.\")",
   "fix": "Pilih satu yang paling benar. Tiga kata sifat berderet adalah refleks mesin.",
   "lang": "id"
  },
  {
   "id": "sapaan-pembuka",
   "regex": "(?im)^\\s*(?:hal+o|hai|hi) (?:sobat|teman-teman|temen-temen|guys|semua|semuanya|kak|bestie|gengs)\\b",
   "name": "Sapaan pembuka (\"Halo sobat...!\")",
   "fix": "Hapus atau pindahkan ke bawah. Baris pertama milik hook.",
   "lang": "id"
  },
  {
   "id": "yuk-simak",
   "regex": "(?i)\\byuk,? (?:simak|kita bahas|cari tahu|kenali|disimak)\\b",
   "name": "\"Yuk, simak!\"",
   "fix": "Hapus. Isi yang bagus tidak perlu diumumkan dulu.",
   "lang": "id"
  },
  {
   "id": "jangan-lupa",
